# Get your API key from https://console.anthropic.com/
#
# LOCAL DEV: set VITE_ANTHROPIC_API_KEY in this file. Vite's dev-server proxy
# (vite.config.js) forwards /anthropic/* to api.anthropic.com with this header.
# This key ends up in the browser — fine for local dev, NEVER use in prod.
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# PRODUCTION (Vercel): do NOT set VITE_ANTHROPIC_API_KEY (it would be bundled
# into public JS). Instead set ANTHROPIC_API_KEY (no VITE_ prefix) in Vercel's
# Project Settings → Environment Variables. The serverless function in
# api/anthropic/messages.js reads it server-side and never exposes it.
